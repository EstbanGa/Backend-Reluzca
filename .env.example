# ==================== Aplicación ====================
PROJECT_NAME=Reluzca API
DEBUG=false
FRONTEND_URL=http://localhost:3000

# ==================== Base de Datos ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reluzca_db
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ==================== Seguridad ====================
# SECRET_KEY se usa solo para operaciones internas (no para JWT de auth)
SECRET_KEY=tu_clave_secreta_super_segura_debe_ser_muy_larga_y_aleatoria_cambiarla_en_produccion

# ==================== CORS ====================
# Separado por comas, sin espacios ni corchetes
# Ejemplo: http://localhost:3000,http://localhost:5173,https://reluzca.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# ==================== Email ====================
EMAIL_BACKEND=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=tu_email@gmail.com
EMAIL_HOST_PASSWORD=tu_app_password_de_gmail
DEFAULT_FROM_EMAIL=noreply@reluzca.com
EMAIL_VERIFICATION_EXPIRY_HOURS=48

# ==================== Supabase ====================
# Configuración de Supabase (reemplaza el JWT local)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu_service_key_de_supabase
SUPABASE_ANON_KEY=tu_anon_key_de_supabase
# La audiencia del JWT de Supabase (por defecto: authenticated)
SUPABASE_JWT_AUDIENCE=authenticated
